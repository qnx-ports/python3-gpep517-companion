0833286540cf100bed9307d86c88586e26f426dcab4dbe7208804953dcce7bfb31a97271b682a27a4263e8b3df579bcffa6cfa845f68b2c8a5fcab9ec2d56311  gpep517
d9a8c02a31d03e29a796ea05cc43c90b582cc84deedd1180cc72a7b0e549d11006630fe66f92c8bcf15af1437e30748d55445f2ccc6f0716d1a53a5b97d0402a  default-bytecode-levels.patch
"
